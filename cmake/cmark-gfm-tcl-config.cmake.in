@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT @BUILD_SHARED_LIBS@)
    set(CMARK_GFM_USE_STATIC_LIBS @CMARK_GFM_USE_STATIC_LIBS@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(CmarkGfm)
    list(POP_BACK CMAKE_MODULE_PATH)
    find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/cmark-gfm-tcl-targets.cmake")
check_required_components(cmark-gfm-tcl)
